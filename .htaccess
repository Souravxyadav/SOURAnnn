# Apache configuration for InfinityFree / Apache web hosting
# DirectoryIndex ensures index.html is served for root requests
DirectoryIndex index.html

# Prevent directory browsing
Options -Indexes

# UTF-8 encoding
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to .git, .env, and sql directories
    RewriteRule ^sql/ - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]
</IfModule>

# Caching directives for static web assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
